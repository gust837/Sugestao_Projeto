@using Projeto.Models
@{
    Layout = null;
}
@section Scripts {
    <script src="~/js/sugestaoCategoria.js"></script>
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="~/css/page-transition.css">
    <script src="~/js/page-transition.js" defer></script>
</head>

<body>
    <form asp-action="NovaSugestao" asp-controller="Sugestao" method="post">
        <label>
            <input type="text" name="Nome">
        </label>
        <label>
            <input type="text" name="Descricao">
        </label>
        <label>
            <select id="categoria">
                <option value="" disabled selected>Selecione</option>
                @if (ViewBag.Categorias != null) foreach (Categoria c in ViewBag.Categorias)
                {
                    <option value="@c.Id">@c.Nome</option>
                }
            </select>
        </label>
        <input type="hidden" name="StatusSugestao" value="E"></input>
        <label>
            <select name="Localizacao">
                <option value="T">terreo</option>
                <option value="1">primeiro andar</option>
                <option value="2">segundo andar</option>
                <option value="C">coworking</option>
                <option value="R">refeitorio</option>
            </select>
        </label>

        <button type="submit">postar</button>
    </form>
</body>

</html>

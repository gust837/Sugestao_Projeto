<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Postar SEMC</title>
    <link rel="stylesheet" href="~/css/postar.css">
</head>
<body>
    <section class="postar">
        <div class="postar_box_area">
            <span class="placeholder">O que podemos melhorar?</span>
            <div class="input_editavel" contenteditable="true"></div>
        </div>
        <nav class="footer_box">
            <ul class="footer_categorias">
                <select name="Categorias" id="">
                    <option value="Categoria" disabled selected>Categoria</option>
                    <option value="Tecnologia">Tecnologia</option>
                    <option value="Infraestrutura">Infraestrutura</option>
                    <option value="Lazer">Lazer</option>
                </select>

                <select name="Local" id="">
                    <option value="Local" selected disabled>Local</option>
                    <option value="1° Andar">1° Andar</option>
                    <option value="2° Andar">2° Andar</option>
                    <option value="Cowork">Cowork</option>
                    <option value="Biblioteca">Biblioteca</option>
                    <option value="Cozinha">Cozinha</option>
                </select>
            </ul>
        </nav>
        <div class="limiteCaracteres">
            <button type="button" class="post_btn">Post</button>
        </div>
    </section>
</body>
</html>
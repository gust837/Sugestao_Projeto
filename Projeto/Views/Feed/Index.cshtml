@using Projeto.Models
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>SEMC - Main Feed</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"
          integrity="sha512-XcIsjKMcuVe0Ucj/xgIXQnytNwBttJbNjltBV18IOnru2lDPe9KRRyvCXw6Y5H415vbBLRm8+q6fmLUU7DfO6Q=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="~/js/editar.js"></script>
    @{
        Layout = null;
    }
<link rel="stylesheet" href="~/css/feed.css">
</head>

<body>

    <nav class="navbar">
        <div class="navbar-logo">
            <span class="logo-text">SEMC</span>
        </div>
        <div class="navbar-actions">
            <button class="btn-icon">
                <i class="ri-logout-circle-line"></i>
            </button>
        </div>
    </nav>

    <div class="main-layout">

        <aside class="sidebar">
            <a asp-action="NovoPost" asp-controller="Feed" method="post" class="a-cta">
                <span class="material-symbols-outlined">add</span>
                Create New Post
            </a>

            <div class="filter-menu">
                <div class="filter-header">
                    <h2>Filtro por status</h2>
                </div>
                <nav class="filter-nav">
                    <button class="filter-btn" id="fe">
                        <i class="ri-check-fill" id="f"></i>
                        <span class="filter-label">Feito</span>
                    </button> 
                    <button class="filter-btn" id="ea">
                        <i class="ri-loader-4-fill" id="a"></i>
                        <span class="filter-label">Em andamento</span>
                    </button>
                    <button class="filter-btn" id="ee">
                        <i class="ri-time-line" id="e"></i>
                        <span class="filter-label">Em espera</span>
                    </button>
                    <button class="filter-btn" id="re">
                        <i class="ri-error-warning-line" id="r"></i>
                        <span class="filter-label">Recusado</span>
                    </button>
                </nav>
            </div>

            <div class="filter-menu">
                <div class="filter-header">
                    <h2>Filtro por Local</h2>
                </div>
                <nav class="filter-nav">
                    <button class="filter-btn" id="aa1">
                        <i class="ri-map-pin-line" id="a1"></i>
                        <span class="filter-label">1 andar</span>
                    </button>
                    <button class="filter-btn" id="aa2">
                        <i class="ri-pin-distance-line" id="a2"></i>
                        <span class="filter-label">2 andar</span>
                        
                    </button>
                    <button class="filter-btn" id="c">
                       <i class="ri-ping-pong-line" id="cow"></i>
                        <span class="filter-label">Cowork</span>
                    </button>
                    <button class="filter-btn" id="refe">
                        <i class="ri-restaurant-line" id="ref"></i>
                        <span class="filter-label">Refeitorio</span>
                    </button>
                    <button class="filter-btn" id="b">
                       <i class="ri-book-shelf-line" id="bibi"></i>
                        <span class="filter-label">Biblioteca</span>
                    </button>
                </nav>
            </div>

            <div class="filter-menu">
                <div class="filter-header">
                    <h2>Filtro por categoria</h2>
                </div>
                <nav class="filter-nav">
                    <button class="filter-btn" id="s">
                       <i class="ri-service-line" id="sus"></i>
                        <span class="filter-label">Sustentabilidade</span>
                    </button>
                    <button class="filter-btn" id="t">
                        <i class="ri-bug-line" id="tec"></i>
                        <span class="filter-label">Tecnologia</span>
                    </button>
                    <button class="filter-btn" id="i">
                        <i class="ri-building-line" id="infra"></i>
                        <span class="filter-label">Infraestrutura</span>
                    </button>
                </nav>
            </div>

            <div class="sidebar-footer">
                <p class="footer-links">
                    <a href="#">About</a>
                    <span class="bullet">•</span>
                    <a href="#">Guidelines</a>
                    <span class="bullet">•</span>
                    <a href="#">Privacy</a>
                </p>
                <p class="copyright">© 2024 SEMC</p>
            </div>
        </aside>

        <main class="feed-container">

            <div class="mobile-filters">
                <button class="mobile-filter-btn">
                    <span class="dot bg-red"></span> Reported
                </button>
                <button class="mobile-filter-btn">
                    <span class="dot bg-yellow"></span> In Progress
                </button>
                <button class="mobile-filter-btn">
                    <span class="dot bg-green"></span> Resolved
                </button>
            </div>

            @foreach (Sugestao s in Model)
            {
                string categorias = string.Join(" • ", s.Sugestao_Categorias.Select(c => c.Categoria.Nome));
                string statusNome = "";

                if (s.StatusSugestao == "A") statusNome = "Em andamento";
                else if (s.StatusSugestao == "E") statusNome = "Em espera";
                else if (s.StatusSugestao == "F") statusNome = "Feito";
                else if (s.StatusSugestao == "R") statusNome = "Recusado";

                TimeSpan diferenca = DateTime.Now - s.DataSugestao;
                string tempoTexto = "";

                if (diferenca.TotalMinutes < 1) tempoTexto = "agora mesmo";
                else if (diferenca.TotalMinutes < 60) tempoTexto = $"{(int)diferenca.TotalMinutes} min";
                else if (diferenca.TotalHours < 24) tempoTexto = $"{(int)diferenca.TotalHours} h";
                else if (diferenca.TotalDays < 7) tempoTexto = $"{(int)diferenca.TotalDays} d";
                else if (diferenca.TotalDays < 30) tempoTexto = $"{(int)(diferenca.TotalDays / 7)} sem";
                else if (diferenca.TotalDays < 365) tempoTexto = $"{(int)(diferenca.TotalDays / 30)} mês";
                else tempoTexto = $"{(int)(diferenca.TotalDays / 365)} ano(s)";

                <article class="post-card">
                    <div class="vote-sidebar">
                        <form asp-action="Votar" asp-controller="Feed" method="post">
                            <input type="hidden" value="@s.Id" name="postId">
                            <button class="vote-btn vote-up" type="submit">
                                <span class="material-symbols-outlined">keyboard_arrow_up</span>
                            </button>
                        </form>
                        <span class="vote-count">@s.Votos</span>
                        @* <button class="vote-btn vote-down">
                            <span class="material-symbols-outlined">keyboard_arrow_down</span>
                        </button> *@
                    </div>
                    <div class="post-content">
                        <div class="post-header">
                            <div class="post-info">
                                <div class="post-meta">
                                    <span class="author">@s.Usuario.Nome</span>
                                    <span class="bullet">•</span>
                                    <span>@tempoTexto</span>
                                    <span class="bullet">•</span>
                                    <span>@categorias</span>
                                </div>
                                <h3 class="post-title">@s.Nome</h3>
                            </div>
                            <div class="editar">
                                <button onclick="esconder(this)" class="status-pill" id="admin">
                                    <span class="ri-check-line"></span> @statusNome
                                </button>
                                <div class="edicao status-panel"><select name="trocar"> 
                                    <option value="" selected disabled>Status</option>
                                    <option value="R">Recusado</option>
                                    <option value="F">Feito</option>
                                    <option value="E">Em espera</option>
                                    <option value="A">Em andamento</option>
                                </select>
                            </div>
                        </div>
                        </div>
                        <p class="post-body">
                            @s.Descricao
                        </p>
                        <div class="post-actions">
                            <button class="btn-action">
                                <span class="material-symbols-outlined">chat_bubble</span> 42 Comments
                            </button>
                        <button class="btn-action salvar-btn">
                            <span class="ri-check-line"></span>
                        </button>
                        <button class="btn-action excluir-btn">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                        </div>
                    </div>
                </article>
            }

            <div class="loading-container">
                <span class="material-symbols-outlined animate-spin">autorenew</span>
            </div>
        </main>
    </div>
-container">
                <span class="material-symbols-outlined animate-spin">autorenew</span>
            </div>
        </main>
    </div>
</body>

</html>
